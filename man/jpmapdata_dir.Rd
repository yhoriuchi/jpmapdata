\name{jpmapdata_dir}
\alias{jpmapdata_dir}
\title{Locate jpmapdata Boundary Files}
\usage{
jpmapdata_dir()
}
\value{
Path to the installed \code{extdata} directory.
}
\description{
Returns the directory where \pkg{jpmapdata} installs its bundled boundary
\code{GeoPackage} files.
}
\examples{
jpmapdata_dir()
}
